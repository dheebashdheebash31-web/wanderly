# Only needed if the API runs on a different origin than the page — e.g.
# during development with `npm run dev` (Vite on :5173) talking to Django
# on :8000. Leave this unset (or delete the file) for the single-server
# setup where Django builds and serves the React app itself; then fetch()
# calls are same-origin and this isn't needed at all.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Used only inside index.html (see the favicon <link> tag) to build the
# correct URL to /public files. Must match vite.config.js's `base` for
# this mode: "/" in dev, since `npm run dev` serves the app from the site
# root.
VITE_BASE_URL=/
