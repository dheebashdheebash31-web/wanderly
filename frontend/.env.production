# Intentionally blank: when Django serves the built app, API calls should
# be relative/same-origin, so VITE_API_BASE_URL is left unset here.

# Used only inside index.html (see the favicon <link> tag) to build the
# correct URL to /public files. Must match vite.config.js's `base` for
# this mode: Django serves the built app under /static/react/.
VITE_BASE_URL=/static/react/
